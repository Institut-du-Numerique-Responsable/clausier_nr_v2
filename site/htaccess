# Clausier Numérique Responsable — site statique sur l'hébergement mutualisé OVH (cluster127).
# Copié dans dist/site/.htaccess par scripts/build_site.py.

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# HTTPS et adresse unique https://clausier.institutnr.org/ (certificats actifs le 19/10/2026)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.clausier\.institutnr\.org$ [NC]
RewriteRule ^(.*)$ https://clausier.institutnr.org/$1 [R=301,L]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://clausier.institutnr.org/$1 [R=301,L]

# Types de fichiers et encodage
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .json .xml .css .js .md
AddType application/json .json
AddType text/markdown .md
AddType application/vnd.openxmlformats-officedocument.spreadsheetml.sheet .xlsx

# En-têtes de sécurité (aucun script ni style inline sur le site)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # analytic.institutnr.org:8443 : Matomo de l'INR (mesure d'audience sans cookie)
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://analytic.institutnr.org:8443; style-src 'self'; script-src 'self' https://analytic.institutnr.org:8443; connect-src 'self' https://analytic.institutnr.org:8443; form-action 'none'; base-uri 'self'; frame-ancestors 'self'"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(xlsx|pdf)$">
    Header set Content-Disposition "attachment"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# Cache : CSS et JS sont versionnés (?v=empreinte), donc cache long sans risque ;
# pages et données en cache court pour refléter chaque publication.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>
