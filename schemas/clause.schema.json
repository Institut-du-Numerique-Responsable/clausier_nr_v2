{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Institut-du-Numerique-Responsable/clausier_nr_v2/schemas/clause.schema.json",
  "title": "En-tête YAML d'une clause du Clausier Numérique Responsable",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titre", "segment", "phase", "section", "ordre", "statut", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(COM|MAT|CLD|LOG|DEV|INF|IA)-(Q|E)-[0-9]{2,3}$",
      "description": "Identifiant stable. Jamais réattribué, même si la clause est archivée."
    },
    "titre": {"type": "string", "minLength": 1},
    "segment": {"enum": ["commun", "materiels", "cloud", "logiciels", "prestations", "ia"]},
    "sous_segment": {"type": ["string", "null"]},
    "phase": {"enum": ["questionnaire", "exigences"]},
    "section": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$"},
    "ordre": {"type": "integer", "minimum": 1},
    "statut": {"enum": ["brouillon", "en_revision", "validee", "archivee"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"},
    "remplace": {"type": "string", "description": "Identifiant de la clause remplacée, le cas échéant."},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document", "section"],
      "properties": {
        "document": {"type": "string"},
        "section": {"type": "string"},
        "tableau": {"type": "string"},
        "ligne": {"type": "integer"},
        "page_pdf": {"type": "integer", "minimum": 1},
        "page_pdf_estimee": {"type": "boolean"},
        "colonnes": {"type": "array", "items": {"type": "string"}},
        "cellules_fusionnees": {"type": "array", "items": {"type": "string"}}
      }
    },
    "excel_preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ligne": {"type": ["integer", "null"]},
        "segment": {"type": "string"},
        "sous_segment": {"type": ["string", "null"]},
        "phase": {"type": "string"},
        "ecarts_de_forme": {"type": "array", "items": {"type": "string"}},
        "ecarts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modifications": {
      "type": "array",
      "description": "Journal des modifications éditoriales apportées au texte d'origine.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "description"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "description": {"type": "string"},
          "rubrique": {"type": "string"},
          "reference": {"type": "string", "description": "Issue, pull request ou décision du comité."}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}}
  }
}
